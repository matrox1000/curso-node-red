    "func": "// Carga los umbrales por defecto si no existen y sincroniza los deslizadores\nlet u = global.get(\"umbrales\");\nif (!u) {\n    u = msg.payload;          // valores por defecto del inject\n    global.set(\"umbrales\", u);\n}\nreturn [\n    { payload: u.suelo.critico },\n    { payload: u.suelo.aviso },\n    { payload: u.temperatura.aviso }\n];",
