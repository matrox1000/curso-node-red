  {
    "id": "d4e5f6a7b8c90016",
    "type": "function",
    "z": "d4e5f6a7b8c90001",
    "name": "grupo Riego y agua",
    "func": "// Contexto global -> widgets del grupo Riego y agua\nconst ultimo = context.get(\"ultimo\") || {};\nconst si_cambia = (clave, valor) => {\n    if (valor === undefined || valor === null) return null;\n    const huella = JSON.stringify(valor);\n    if (huella === ultimo[clave]) return null;\n    ultimo[clave] = huella;\n    return { payload: valor };\n};\nconst s = global.get(\"sensores\") || {};\nconst dep = flow.get(\"deposito\");   // dimensiones del depósito\nconst d = s.ultrasonidos?.distancia?.valor;\n\n// Distancia del sensor al agua -> nivel en %\nlet nivel;\nif (d !== undefined && dep) {\n    nivel = (dep.vacioCm - d) / (dep.vacioCm - dep.llenoCm) * 100;\n    nivel = Math.round(Math.min(100, Math.max(0, nivel)));\n}\nconst tds = s.tds?.tds?.valor;\nconst peso = s.balanza?.peso?.valor;\nconst salidas = [\n    si_cambia(\"suelo\", s.suelo?.humedad?.valor),\n    si_cambia(\"nivel\", nivel),\n    si_cambia(\"tds\", tds !== undefined ? `${Math.round(tds)} ppm` : undefined),\n    si_cambia(\"peso\", peso !== undefined ? `${(peso / 1000).toFixed(2)} kg` : undefined)\n];\ncontext.set(\"ultimo\", ultimo);\nreturn salidas;",
    "outputs": 4,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 350,
    "y": 340,
    "wires": [
