  {
    "id": "d4e5f6a7b8c90017",
    "type": "function",
    "z": "d4e5f6a7b8c90001",
    "name": "grupo Actuadores",
    "func": "// Estado CONFIRMADO de los actuadores -> interruptores (modo decouple)\nconst ultimo = context.get(\"ultimo\") || {};\nconst si_cambia = (clave, valor) => {\n    if (valor === undefined || valor === null) return null;\n    const huella = JSON.stringify(valor);\n    if (huella === ultimo[clave]) return null;\n    ultimo[clave] = huella;\n    return { payload: valor };\n};\nconst a = global.get(\"actuadores\") || {};\nconst v = global.get(\"ventilacion\");\nconst salidas = [\n    si_cambia(\"bomba\", a.bomba?.estado),\n    si_cambia(\"ventilador\", a.ventilador?.estado),\n    si_cambia(\"vent\", v ? v.motivo : undefined)\n];\ncontext.set(\"ultimo\", ultimo);\nreturn salidas;",
    "outputs": 3,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
