  {
    "id": "d4e5f6a7b8c90045",
    "type": "function",
    "z": "d4e5f6a7b8c90001",
    "name": "actualizar umbrales",
    "func": "// msg.topic = ruta del umbral (\"suelo.critico\"), msg.payload = nuevo valor\nconst u = global.get(\"umbrales\");\nconst [grupo, clave] = msg.topic.split(\".\");\nconst nuevo = structuredClone(u);\nnuevo[grupo][clave] = Number(msg.payload);\n\n// Validación: el umbral crítico del suelo debe quedar por debajo del de aviso\nif (nuevo.suelo.critico >= nuevo.suelo.aviso) {\n    // Rechazado: aviso al operador y los deslizadores vuelven a su valor\n    return [{ payload: \"Consigna rechazada: el umbral crítico debe ser menor que el de aviso\" }, { payload: u }];\n}\nglobal.set(\"umbrales\", nuevo);\nnode.status({ fill: \"green\", shape: \"dot\", text: `${msg.topic} = ${msg.payload}` });\nreturn [{ payload: `Consigna actualizada: ${msg.topic} = ${msg.payload}` }, { payload: nuevo }];",
    "outputs": 2,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 910,
    "y": 960,
