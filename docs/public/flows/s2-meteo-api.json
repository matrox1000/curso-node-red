    "type": "function",
    "z": "b2c3d4e5f6a70001",
    "name": "componer estado",
    "func": "const meteo = global.get(\"meteo\");\n\nmsg.payload = {\n    ts: new Date().toISOString(),\n    ventilacion: global.get(\"ventilacion\") ?? null,\n    meteo: meteo ?? null,\n    antiguedadMeteoMin: meteo ? Math.round((Date.now() - meteo.ts) / 60000) : null\n};\nreturn msg;",
