  {
    "id": "b2c3d4e5f6a70010",
    "type": "function",
    "z": "b2c3d4e5f6a70001",
    "name": "extraer previsión",
    "func": "// Resume la respuesta en los campos que usa el sistema\nconst c = msg.payload.current;\nconst h = msg.payload.hourly;\nconst suma = a => a.reduce((s, x) => s + (x ?? 0), 0);\n\nconst meteo = {\n    tempExterior: c.temperature_2m,\n    humExterior: c.relative_humidity_2m,\n    lluvia6h: Math.round(suma(h.precipitation) * 10) / 10,\n    probLluviaMax: Math.max(...h.precipitation_probability),\n    et0_6h: Math.round(suma(h.et0_fao_evapotranspiration) * 100) / 100,\n    ts: Date.now()\n};\nglobal.set(\"meteo\", meteo);\n\nnode.status({ fill: \"green\", shape: \"dot\", text: `${meteo.tempExterior} ºC fuera` });\nmsg.payload = meteo;\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 890,
    "y": 160,
    "wires": [
      [
        "b2c3d4e5f6a70011"
      ]
    ]
  },
