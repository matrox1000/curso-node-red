    "type": "function",
    "z": "b2c3d4e5f6a70001",
    "name": "respuesta inesperada",
    "func": "// La API ha respondido, pero no con 200 (p. ej. 400 por parámetros incorrectos)\nconst motivo = msg.payload && msg.payload.reason ? msg.payload.reason : \"sin detalle\";\nnode.status({ fill: \"red\", shape: \"ring\", text: `HTTP ${msg.statusCode}` });\nmsg.payload = { origen: \"Open-Meteo\", statusCode: msg.statusCode, motivo };\nreturn msg;",
    "outputs": 1,
