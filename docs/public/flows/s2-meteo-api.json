  {
    "id": "b2c3d4e5f6a70007",
    "type": "function",
    "z": "b2c3d4e5f6a70001",
    "name": "construir URL",
    "func": "// Coordenadas del invernadero desde variables de entorno del contenedor\nconst lat = env.get(\"INVERNADERO_LAT\") || \"38.3852\";\nconst lon = env.get(\"INVERNADERO_LON\") || \"-0.5143\";\n\nmsg.url = \"https://api.open-meteo.com/v1/forecast\"\n    + `?latitude=${lat}&longitude=${lon}`\n    + \"&current=temperature_2m,relative_humidity_2m\"\n    + \"&hourly=precipitation_probability,precipitation,et0_fao_evapotranspiration\"\n    + \"&forecast_hours=6&timezone=Europe%2FMadrid\";\nmsg.requestTimeout = 10000;   // ms: sin respuesta en 10 s -> error\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 340,
    "y": 180,
    "wires": [
      [
        "b2c3d4e5f6a70008"
      ]
    ]
  },
