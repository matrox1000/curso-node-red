  {
    "id": "a1b2c3d4e5f60030",
    "type": "function",
    "z": "a1b2c3d4e5f60001",
    "name": "decidir riego",
    "func": "// Guarda el último estado en el contexto de flujo y decide la acción\nconst anterior = flow.get(\"estadoSuelo\");\nflow.set(\"estadoSuelo\", msg.estado);\nflow.set(\"ultimaHumedadSuelo\", msg.payload);\n\nconst accion = msg.estado === \"crítico\" ? \"regar\" : \"no regar\";\n\nmsg.payload = {\n    humedad: msg.payload,\n    estado: msg.estado,\n    accion: accion,\n    cambio: msg.estado !== anterior\n};\n\nnode.status({\n    fill: msg.estado === \"normal\" ? \"green\" : msg.estado === \"aviso\" ? \"yellow\" : \"red\",\n    shape: \"dot\",\n    text: `${msg.payload.humedad} % → ${accion}`\n});\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 980,
    "y": 240,
    "wires": [["a1b2c3d4e5f60031"]]
  },
