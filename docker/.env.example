# Copia este fichero como .env y ajusta el bloque según dónde trabajes.

# ---------------------------------------------------------------------
# CASA: broker local + simulador del invernadero
COMPOSE_PROFILES=casa
MQTT_HOST=mosquitto

# LABORATORIO: broker central de la Raspberry Pi (comenta el bloque de
# arriba y descomenta este)
# COMPOSE_PROFILES=
# MQTT_HOST=192.168.0.10
# ---------------------------------------------------------------------

MQTT_PORT=1883

# Contraseñas del broker local. Si pones en MQTT_ALUMNO_PASS la misma
# contraseña del usuario 'alumno' del laboratorio, no tendrás que tocar
# nada en Node-RED al cambiar de sitio.
MQTT_ALUMNO_PASS=alumno
MQTT_PROFESOR_PASS=profesor
MQTT_SIMULADOR_PASS=simulador

# Coordenadas del invernadero (sesión 2, API meteorológica).
# Por defecto: campus de la Universidad de Alicante.
INVERNADERO_LAT=38.3852
INVERNADERO_LON=-0.5143

# 60 = 1 minuto real equivale a 1 hora simulada
SIM_VELOCIDAD=60

# InfluxDB (sesión 5)
INFLUX_USER=admin
INFLUX_PASS=invernadero
INFLUX_ORG=invernadero
INFLUX_BUCKET=sensores
INFLUX_TOKEN=token-curso-node-red

TZ=Europe/Madrid
